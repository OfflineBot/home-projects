# Copy to .env and fill in. Nothing here has a default that would be safe.

POSTGRES_USER=homeprojects
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homeprojects

# Signs the access tokens. Any long random string.
JWT_SECRET=change-me-to-something-long-and-random
# Encrypts the credentials in the accounts menu. Changing it makes every
# stored password unreadable — they then have to be entered again.
SECRET_KEY=change-me-to-something-long-and-random-too

# The address the server is reachable at from outside. Clone URLs, calendar
# subscription links and webhook addresses are built from it.
PUBLIC_URL=http://localhost:8080

# Only used on the very first start, when no user exists yet.
OWNER_USERNAME=offlinebot
OWNER_PASSWORD=change-me-at-least-ten-chars

# Set to true behind HTTPS.
COOKIE_SECURE=false

# Where the data lives on the host. Both are bind mounts on purpose.
GIT_DIR=./srv/git
DATA_DIR=./srv/data

# project.yaml may declare `from: command` variables. Off by default: a
# versioned file that runs shell commands deserves an explicit yes.
ALLOW_PROJECT_COMMANDS=false

# Local only. Use 0.0.0.0:8080 to open it to the network on purpose.
FRONTEND_PORT=127.0.0.1:8080
DB_PORT=127.0.0.1:5433
TZ=Europe/Berlin
